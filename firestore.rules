rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }
    function premium(uid) {
      return exists(/databases/$(database)/documents/entitlements/$(uid))
        && get(/databases/$(database)/documents/entitlements/$(uid)).data.premium == true;
    }
    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    function activePath(uid) {return /databases/$(database)/documents/users/$(uid)/active/current;}
    function attemptValid() {
      let d=request.resource.data;
      return d.keys().hasOnly(['id','type','questionIds','answers','position','level','correct','total','currentId','selected','answered','updatedAt'])
        && d.keys().hasAll(['id','type','questionIds','answers','position','level','correct','total','currentId','selected','answered','updatedAt'])
        && d.id is string && d.id.matches('[a-f0-9-]{36}')
        && d.type in ['knowledge','inductive']
        && d.questionIds is list && d.questionIds.size() >= 1 && d.questionIds.size() <= 25
        && d.answers is list && d.answers.size() <= 25
        && d.position is int && d.position >= 0 && d.position < 25
        && d.level is int && d.level >= 0 && d.level <= 10
        && d.correct is int && d.correct >= 0 && d.correct <= 18
        && d.total is int && d.total >= 0 && d.total <= 18
        && d.currentId is string && d.currentId.size() <= 30
        && (d.selected == null || (d.selected is int && d.selected >= 0 && d.selected < 5))
        && d.answered is bool && d.updatedAt == request.time
        && ((d.type == 'knowledge' && d.questionIds.size() == 25 && d.answers.size() == 25 && d.level == 0 && d.total == 0 && d.correct == 0 && d.currentId == '')
          || (d.type == 'inductive' && d.questionIds.size() <= 18 && d.answers.size() == 0 && d.position == 0 && d.level >= 1 && d.currentId.size() > 0));
    }
    function resultFields() {
      return request.resource.data.keys().hasOnly(['type', 'correct', 'total', 'at'])
        && request.resource.data.keys().hasAll(['type', 'correct', 'total', 'at'])
        && request.resource.data.type in ['knowledge', 'inductive']
        && request.resource.data.correct is int
        && request.resource.data.total is int
        && ((request.resource.data.type == 'knowledge' && request.resource.data.total == 25)
          || (request.resource.data.type == 'inductive' && request.resource.data.total == 18))
        && request.resource.data.correct >= 0
        && request.resource.data.correct <= request.resource.data.total
        && request.resource.data.at == request.time;
    }
    match /users/{uid} {
      allow get: if signed(uid);
      allow list: if false;
      allow create: if signed(uid)
        && request.resource.data.keys().hasOnly(['started', 'createdAt'])
        && request.resource.data.keys().hasAll(['started', 'createdAt'])
        && request.resource.data.started == 0
        && request.resource.data.createdAt == request.time;
      // Legacy όνομα "started": από τη v2 μετρά ΟΛΟΚΛΗΡΩΜΕΝΑ δωρεάν τεστ.
      // Η αλλαγή επιτρέπεται ΜΟΝΟ μαζί με τη δημιουργία του αντίστοιχου αποτελέσματος.
      allow update: if signed(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['started'])
        && resource.data.started is int
        && resource.data.started >= 0 && resource.data.started < 3
        && request.resource.data.started == resource.data.started + 1
        && (
          (resource.data.started == 0 && !exists(/databases/$(database)/documents/users/$(uid)/results/completed-1) && existsAfter(/databases/$(database)/documents/users/$(uid)/results/completed-1))
          || (resource.data.started == 1 && !exists(/databases/$(database)/documents/users/$(uid)/results/completed-2) && existsAfter(/databases/$(database)/documents/users/$(uid)/results/completed-2))
          || (resource.data.started == 2 && !exists(/databases/$(database)/documents/users/$(uid)/results/completed-3) && existsAfter(/databases/$(database)/documents/users/$(uid)/results/completed-3))
        );
      allow delete: if false;

      // Ειδική πρόοδος εκμάθησης, χωρίς καμία επίδραση στις δωρεάν προσπάθειες.
      match /study/{kind} {
        allow get: if signed(uid) && kind in ['knowledge','inductive'];
        allow list: if false;
        allow create, update: if signed(uid) && kind in ['knowledge','inductive']
          && request.resource.data.keys().hasOnly(['category','questionId','position','level','seenIds','correct','total','selected','answered','updatedAt'])
          && request.resource.data.keys().hasAll(['category','questionId','position','level','seenIds','correct','total','selected','answered','updatedAt'])
          && request.resource.data.category is string && request.resource.data.category.size() <= 160
          && request.resource.data.questionId is string && request.resource.data.questionId.size() <= 40
          && request.resource.data.position is int && request.resource.data.position >= 0 && request.resource.data.position <= 25000
          && request.resource.data.level is int && request.resource.data.level >= 0 && request.resource.data.level <= 10
          && request.resource.data.seenIds is list && request.resource.data.seenIds.size() <= 100
          && request.resource.data.correct is int && request.resource.data.correct >= 0 && request.resource.data.correct <= 100
          && request.resource.data.total is int && request.resource.data.total >= 0 && request.resource.data.total <= 100
          && (request.resource.data.selected == null || (request.resource.data.selected is int && request.resource.data.selected >= 0 && request.resource.data.selected <= 4))
          && request.resource.data.answered is bool
          && request.resource.data.updatedAt == request.time
          && (kind != 'knowledge' || (request.resource.data.seenIds.size() == 0 && request.resource.data.level == 0));
        allow delete: if signed(uid) && kind in ['knowledge','inductive'];
      }
      match /active/{attemptDoc} {
        allow get: if attemptDoc == 'current' && signed(uid);
        allow list: if false;
        allow create: if attemptDoc == 'current' && signed(uid) && attemptValid()
          && (premium(uid) || (get(profilePath(uid)).data.started is int && get(profilePath(uid)).data.started < 3));
        // Συνέχιση ίδιας προσπάθειας ή αντικατάσταση από "Νέο τεστ".
        // Αλλαγή ID επιτρέπεται μόνο με διαθέσιμη δωρεάν πρόσβαση ή Premium.
        allow update: if attemptDoc == 'current' && signed(uid) && attemptValid()
          && ((request.resource.data.id == resource.data.id
                && request.resource.data.type == resource.data.type)
              || (request.resource.data.id != resource.data.id
                && (premium(uid) || (get(profilePath(uid)).data.started is int
                  && get(profilePath(uid)).data.started < 3))));
        allow delete: if attemptDoc == 'current' && signed(uid);
      }
      match /results/{resultId} {
        allow get, list: if signed(uid);
        // Για δωρεάν: καταχώριση αποτελέσματος και αύξηση counter στην ίδια transaction.
        // Για Premium: το entitlement πρέπει να έχει οριστεί από admin.
        allow create: if signed(uid) && resultFields()
          && exists(activePath(uid))
          && get(activePath(uid)).data.type == request.resource.data.type
          && !existsAfter(activePath(uid))
          && (
            (premium(uid) && resultId == 'premium-' + get(activePath(uid)).data.id)
            ||
            (((get(profilePath(uid)).data.started == 0 && resultId == 'completed-1')
                || (get(profilePath(uid)).data.started == 1 && resultId == 'completed-2')
                || (get(profilePath(uid)).data.started == 2 && resultId == 'completed-3'))
              && get(profilePath(uid)).data.started is int
              && get(profilePath(uid)).data.started >= 0
              && get(profilePath(uid)).data.started < 3
              && getAfter(profilePath(uid)).data.started == get(profilePath(uid)).data.started + 1)
          );
        allow update, delete: if false;
      }
    }
    // Δημιουργείται μόνο χειροκίνητα από Firebase Console ή trusted backend/Admin SDK.
    match /entitlements/{uid} {
      allow get: if signed(uid);
      allow list, create, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
