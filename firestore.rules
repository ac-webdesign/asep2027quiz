rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && !exists(/databases/$(database)/documents/accountDeletionLocks/$(uid));
    }
    function premium(uid) {
      return exists(/databases/$(database)/documents/entitlements/$(uid))
        && get(/databases/$(database)/documents/entitlements/$(uid)).data.premium == true;
    }
    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    function activePath(uid) {return /databases/$(database)/documents/users/$(uid)/active/current;}
    function attemptValid() {
      let d=request.resource.data;
      return d.keys().hasOnly(['id','type','questionIds','answers','position','level','correct','total','currentId','selected','answered','timed','startedAt','updatedAt'])
        && d.keys().hasAll(['id','type','questionIds','answers','position','level','correct','total','currentId','selected','answered','updatedAt'])
        && d.id is string && d.id.matches('[a-f0-9-]{36}')
        && d.type in ['knowledge','inductive']
        && d.questionIds is list && d.questionIds.size() >= 1 && d.questionIds.size() <= 50
        && d.answers is list && d.answers.size() <= 50
        && d.position is int && d.position >= 0 && d.position < 50
        && d.level is int && d.level >= 0 && d.level <= 10
        && d.correct is int && d.correct >= 0 && d.correct <= 25
        && d.total is int && d.total >= 0 && d.total <= 25 && d.correct <= d.total
        && d.currentId is string && d.currentId.size() <= 30
        && (d.selected == null || (d.selected is int && d.selected >= 0 && d.selected < 5))
        && d.answered is bool && d.updatedAt == request.time
        && (!('timed' in d) || d.timed is bool)
        && (!('startedAt' in d) || d.startedAt is timestamp)
        && (d.get('timed',false) != true || 'startedAt' in d)
        && ((d.type == 'knowledge' && d.questionIds.size() in [10,25,50] && d.answers.size() == d.questionIds.size() && d.position < d.questionIds.size() && d.level == 0 && d.total == 0 && d.correct == 0 && d.currentId == '')
          || (d.type == 'inductive' && d.level >= 1 && d.currentId.size() > 0 && ((d.answers.size() == 0 && d.questionIds.size() <= 18 && d.position == 0) || (d.questionIds.size() in [7,18,25] && d.answers.size() == d.questionIds.size() && d.position < d.questionIds.size()))));
    }
    function count11(v) {
      return v is list && v.size() == 11
        && v[0] is int && v[1] is int && v[2] is int && v[3] is int
        && v[4] is int && v[5] is int && v[6] is int && v[7] is int
        && v[8] is int && v[9] is int && v[10] is int
        && v[0] >= 0 && v[1] >= 0 && v[2] >= 0 && v[3] >= 0
        && v[4] >= 0 && v[5] >= 0 && v[6] >= 0 && v[7] >= 0
        && v[8] >= 0 && v[9] >= 0 && v[10] >= 0;
    }
    function sum11(v) {
      return v[0]+v[1]+v[2]+v[3]+v[4]+v[5]+v[6]+v[7]+v[8]+v[9]+v[10];
    }
    function lessEqual11(a,b) {
      return a[0]<=b[0] && a[1]<=b[1] && a[2]<=b[2] && a[3]<=b[3]
        && a[4]<=b[4] && a[5]<=b[5] && a[6]<=b[6] && a[7]<=b[7]
        && a[8]<=b[8] && a[9]<=b[9] && a[10]<=b[10];
    }
    function resultFields() {
      let d = request.resource.data;
      return d.keys().hasOnly(['type', 'correct', 'total', 'at', 'categoryCorrect', 'categoryTotal', 'timed', 'elapsedSeconds'])
        && d.keys().hasAll(['type', 'correct', 'total', 'at'])
        && d.type in ['knowledge', 'inductive']
        && d.correct is int && d.total is int
        && ((d.type == 'knowledge' && d.total in [10,25,50]) || (d.type == 'inductive' && d.total in [7,18,25]))
        && d.correct >= 0 && d.correct <= d.total && d.at == request.time
        && (!('timed' in d) || d.timed is bool)
        && (!('elapsedSeconds' in d) || (d.elapsedSeconds is int && d.elapsedSeconds >= 0
          && d.elapsedSeconds <= (d.type == 'knowledge' ? d.total * 60 : (d.total == 7 ? 600 : (d.total == 18 ? 1500 : 2100)))))
        // Παλιοί clients: επιτρέπουμε το αρχικό αποτέλεσμα χωρίς ανάλυση.
        && ((!('categoryCorrect' in d) && !('categoryTotal' in d))
          || ('categoryCorrect' in d && 'categoryTotal' in d
            && count11(d.categoryCorrect) && count11(d.categoryTotal)
            && lessEqual11(d.categoryCorrect, d.categoryTotal)
            && sum11(d.categoryCorrect) == (d.type == 'knowledge' ? d.correct : 0)
            && sum11(d.categoryTotal) == (d.type == 'knowledge' ? d.total : 0)));
    }
    function statsFields() {
      let d = request.resource.data;
      return d.keys().hasOnly(['schema','knowledgeTests','knowledgeCorrect','knowledgeTotal',
        'knowledgeBest','inductiveTests','inductiveCorrect','inductiveTotal','inductiveBest',
        'categoryCorrect','categoryTotal','createdAt','updatedAt'])
        && d.keys().hasAll(['schema','knowledgeTests','knowledgeCorrect','knowledgeTotal',
        'knowledgeBest','inductiveTests','inductiveCorrect','inductiveTotal','inductiveBest',
        'categoryCorrect','categoryTotal','createdAt','updatedAt'])
        && d.schema == 1
        && d.knowledgeTests is int && d.knowledgeTests >= 0
        && d.knowledgeCorrect is int && d.knowledgeCorrect >= 0
        && d.knowledgeTotal is int && d.knowledgeTotal >= 0
        && d.inductiveTests is int && d.inductiveTests >= 0
        && d.inductiveCorrect is int && d.inductiveCorrect >= 0
        && d.inductiveTotal is int && d.inductiveTotal >= 0
        && d.knowledgeBest is int && d.knowledgeBest >= 0 && d.knowledgeBest <= 100
        && d.inductiveBest is int && d.inductiveBest >= 0 && d.inductiveBest <= 100
        && d.knowledgeCorrect <= d.knowledgeTotal
        && d.inductiveCorrect <= d.inductiveTotal
        && d.knowledgeTotal >= d.knowledgeTests * 10
        && d.knowledgeTotal <= d.knowledgeTests * 50
        && d.inductiveTotal >= d.inductiveTests * 7
        && d.inductiveTotal <= d.inductiveTests * 25
        && count11(d.categoryCorrect) && count11(d.categoryTotal)
        && lessEqual11(d.categoryCorrect, d.categoryTotal)
        && sum11(d.categoryCorrect) == d.knowledgeCorrect
        && sum11(d.categoryTotal) == d.knowledgeTotal
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /users/{uid} {
      allow get: if signed(uid);
      allow list: if false;
      allow create: if signed(uid)
        && request.resource.data.keys().hasOnly(['started', 'createdAt'])
        && request.resource.data.keys().hasAll(['started', 'createdAt'])
        && request.resource.data.started == 0
        && request.resource.data.createdAt == request.time;
      // Legacy όνομα "started": από τη v2 μετρά ΟΛΟΚΛΗΡΩΜΕΝΑ δωρεάν τεστ.
      // Η αλλαγή επιτρέπεται ΜΟΝΟ μαζί με τη δημιουργία του αντίστοιχου αποτελέσματος.
      allow update: if signed(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['started'])
        && resource.data.started is int
        && resource.data.started >= 0 && resource.data.started < 5
        && request.resource.data.started == resource.data.started + 1
        && (
          (resource.data.started == 0 && !exists(/databases/$(database)/documents/users/$(uid)/results/completed-1) && existsAfter(/databases/$(database)/documents/users/$(uid)/results/completed-1))
          || (resource.data.started == 1 && !exists(/databases/$(database)/documents/users/$(uid)/results/completed-2) && existsAfter(/databases/$(database)/documents/users/$(uid)/results/completed-2))
          || (resource.data.started == 2 && !exists(/databases/$(database)/documents/users/$(uid)/results/completed-3) && existsAfter(/databases/$(database)/documents/users/$(uid)/results/completed-3))
          || (resource.data.started == 3 && !exists(/databases/$(database)/documents/users/$(uid)/results/completed-4) && existsAfter(/databases/$(database)/documents/users/$(uid)/results/completed-4))
          || (resource.data.started == 4 && !exists(/databases/$(database)/documents/users/$(uid)/results/completed-5) && existsAfter(/databases/$(database)/documents/users/$(uid)/results/completed-5))
        );
      allow delete: if false;

      // Ειδική πρόοδος εκμάθησης, χωρίς καμία επίδραση στις δωρεάν προσπάθειες.
      match /study/{kind} {
        allow get: if signed(uid) && kind in ['knowledge','inductive'];
        allow list: if false;
        allow create, update: if signed(uid) && kind in ['knowledge','inductive']
          && request.resource.data.keys().hasOnly(['category','questionId','position','level','seenIds','wrongIds','reviewMode','correct','total','selected','answered','updatedAt'])
          && request.resource.data.keys().hasAll(['category','questionId','position','level','seenIds','correct','total','selected','answered','updatedAt'])
          && request.resource.data.category is string && request.resource.data.category.size() <= 160
          && request.resource.data.questionId is string && request.resource.data.questionId.size() <= 40
          && request.resource.data.position is int && request.resource.data.position >= 0 && request.resource.data.position <= 25000
          && request.resource.data.level is int && request.resource.data.level >= 0 && request.resource.data.level <= 10
          && request.resource.data.seenIds is list && request.resource.data.seenIds.size() <= 200
          && (!('wrongIds' in request.resource.data) ||
              (request.resource.data.wrongIds is list && request.resource.data.wrongIds.size() <= 200))
          && (!('reviewMode' in request.resource.data) || request.resource.data.reviewMode is bool)
          && request.resource.data.correct is int && request.resource.data.correct >= 0 && request.resource.data.correct <= 200
          && request.resource.data.total is int && request.resource.data.total >= 0 && request.resource.data.total <= 200
          && (request.resource.data.selected == null || (request.resource.data.selected is int && request.resource.data.selected >= 0 && request.resource.data.selected <= 4))
          && request.resource.data.answered is bool
          && request.resource.data.updatedAt == request.time
          && (kind != 'knowledge' || (request.resource.data.seenIds.size() == 0 && request.resource.data.level == 0));
        allow delete: if signed(uid) && kind in ['knowledge','inductive'];
      }
      match /active/{attemptDoc} {
        allow get: if attemptDoc == 'current' && signed(uid);
        allow list: if false;
        allow create: if attemptDoc == 'current' && signed(uid) && attemptValid()
          && (!('startedAt' in request.resource.data) || request.resource.data.startedAt == request.time)
          && (premium(uid) || (get(profilePath(uid)).data.started is int && get(profilePath(uid)).data.started < 5));
        // Συνέχιση ίδιας προσπάθειας ή αντικατάσταση από "Νέο τεστ".
        // Αλλαγή ID επιτρέπεται μόνο με διαθέσιμη δωρεάν πρόσβαση ή Premium.
        allow update: if attemptDoc == 'current' && signed(uid) && attemptValid()
          && ((request.resource.data.id == resource.data.id
                && request.resource.data.type == resource.data.type
                && (!('startedAt' in resource.data) || request.resource.data.startedAt == resource.data.startedAt)
                && (!('timed' in resource.data) || request.resource.data.timed == resource.data.timed))
              || (request.resource.data.id != resource.data.id
                && (!('startedAt' in request.resource.data) || request.resource.data.startedAt == request.time)
                && (premium(uid) || (get(profilePath(uid)).data.started is int
                  && get(profilePath(uid)).data.started < 5))));
        allow delete: if attemptDoc == 'current' && signed(uid);
      }
      // Συγκεντρωτικοί δείκτες. Η εγγραφή επιτρέπεται μόνο στην ίδια
      // ατομική ολοκλήρωση με τη διαγραφή της ενεργής προσπάθειας.
      // Όπως τα υπάρχοντα αποτελέσματα, οι επιδόσεις βαθμολογούνται στον client
      // και δεν αποτελούν πιστοποιημένη βαθμολογία εξετάσεων.
      match /stats/{statsId} {
        allow get: if statsId == 'overview' && signed(uid);
        allow list: if false;
        allow create: if statsId == 'overview' && signed(uid) && statsFields()
          && request.resource.data.createdAt == request.time
          && exists(activePath(uid)) && !existsAfter(activePath(uid));
        allow update: if statsId == 'overview' && signed(uid) && statsFields()
          && request.resource.data.createdAt == resource.data.createdAt
          && exists(activePath(uid)) && !existsAfter(activePath(uid));
        allow delete: if false;
      }
      match /results/{resultId} {
        allow get, list: if signed(uid);
        // Για δωρεάν: καταχώριση αποτελέσματος και αύξηση counter στην ίδια transaction.
        // Για Premium: το entitlement πρέπει να έχει οριστεί από admin.
        allow create: if signed(uid) && resultFields()
          && exists(activePath(uid))
          && get(activePath(uid)).data.type == request.resource.data.type
          && !existsAfter(activePath(uid))
          && (
            (premium(uid) && resultId == 'premium-' + get(activePath(uid)).data.id)
            ||
            (((get(profilePath(uid)).data.started == 0 && resultId == 'completed-1')
                || (get(profilePath(uid)).data.started == 1 && resultId == 'completed-2')
                || (get(profilePath(uid)).data.started == 2 && resultId == 'completed-3')
                || (get(profilePath(uid)).data.started == 3 && resultId == 'completed-4')
                || (get(profilePath(uid)).data.started == 4 && resultId == 'completed-5'))
              && get(profilePath(uid)).data.started is int
              && get(profilePath(uid)).data.started >= 0
              && get(profilePath(uid)).data.started < 5
              && getAfter(profilePath(uid)).data.started == get(profilePath(uid)).data.started + 1)
          );
        allow update, delete: if false;
      }
    }
    // Εσωτερικός προσωρινός δείκτης ασφαλείας κατά τη διαγραφή λογαριασμού.
    match /accountDeletionLocks/{uid} {
      allow read, write: if false;
    }
    // Δημιουργείται μόνο χειροκίνητα από Firebase Console ή trusted backend/Admin SDK.
    match /entitlements/{uid} {
      allow get: if signed(uid);
      allow list, create, update, delete: if false;
    }
    // Προετοιμασία συνδρομών: ο χρήστης διαβάζει μόνο τη δική του κατάσταση.
    // Εγγραφές / αλλαγές γίνονται αποκλειστικά από trusted backend (Admin SDK).
    // Η συλλογή αυτή ΔΕΝ ενεργοποιεί Premium πριν συνδεθεί ο backend έλεγχος.
    match /subscriptions/{uid} {
      allow get: if signed(uid);
      allow list, create, update, delete: if false;
    }
    // Ιδιωτικά συμβάντα πληρωμών και αντιστοιχίσεις παρόχων.
    match /billingEvents/{eventId} {
      allow read, write: if false;
    }
    match /billingCustomers/{customerId} {
      allow read, write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
